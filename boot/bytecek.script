Window.SetBackgroundTopColor(0.141, 0.141, 0.141);
Window.SetBackgroundBottomColor(0.141, 0.141, 0.141);
logo.image = Image("b.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
status.image = Image.Text("Starting Bytecek TV...", 0.9, 0.9, 0.9);
status.sprite = Sprite(status.image);
status.sprite.SetX(Window.GetWidth() / 2 - status.image.GetWidth() / 2);
status.sprite.SetY(Window.GetHeight() * 0.65);
// Show disk-encryption prompts rather than hiding a required passphrase.
fun password_callback(prompt, bullets) {
  global.password = Sprite(Image.Text(prompt + " " + bullets, 1, 1, 1));
  password.SetX(Window.GetWidth() * 0.2);
  password.SetY(Window.GetHeight() * 0.7);
}
fun normal_callback() {
  global.password = Sprite();
}
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
