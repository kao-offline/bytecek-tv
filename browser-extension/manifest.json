{
  "manifest_version": 3,
  "name": "Bytecek TV comfort",
  "version": "1.1.0",
  "description": "Dark loading canvas, reduced motion and Spilled continue-watching for the TV launcher.",
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["comfort.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://spilled.kaooffline.top/*"],
      "js": ["spilled.js"],
      "run_at": "document_idle"
    }
  ]
}
